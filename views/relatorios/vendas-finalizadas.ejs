<div class="page-header">
  <h1>Relatório de Vendas Finalizadas</h1>
</div>

<form method="GET" action="/relatorios/vendas-finalizadas" class="form-filtro">
  <div class="campo">
    <label for="dataInicio">Data inicial</label>
    <input type="date" id="dataInicio" name="dataInicio" value="<%= filtro.dataInicio %>" />
  </div>
  <div class="campo">
    <label for="dataFim">Data final</label>
    <input type="date" id="dataFim" name="dataFim" value="<%= filtro.dataFim %>" />
  </div>
  <div class="form-acoes">
    <button type="submit" class="btn btn-primary">Filtrar</button>
    <a href="/relatorios/vendas-finalizadas" class="btn btn-secundario">Limpar</a>
  </div>
</form>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Data da Venda</th>
        <th>Forma de Pagamento</th>
        <th>Cliente</th>
        <th>Telefone</th>
        <th>Valor Total</th>
        <th>Quantidade de Peças</th>
      </tr>
    </thead>
    <tbody>
      <% if (vendas.length === 0) { %>
        <tr>
          <td colspan="6">Nenhuma venda finalizada encontrada.</td>
        </tr>
      <% } %>

      <% for (const venda of vendas) { %>
        <tr>
          <td><%= formatarData(venda.dataVenda) %></td>
          <td><%= venda.formaPagamentoRotulo %></td>
          <td><%= venda.clienteNome %></td>
          <td><%= venda.clienteTelefone %></td>
          <td><%= formatarMoeda(venda.valorTotalCompra) %></td>
          <td><%= venda.quantidadeTotalPecas %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/paginacao', { paginacao, queryBase: filtro }) %>
