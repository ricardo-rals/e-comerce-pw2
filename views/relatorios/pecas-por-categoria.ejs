<div class="page-header">
  <h1>Relatório de Peças por Categoria</h1>
</div>

<form method="GET" action="/relatorios/pecas-por-categoria" class="form-card">
  <div class="campo">
    <label for="categoria">Categoria</label>
    <select id="categoria" name="categoria" required>
      <option value="">Selecione...</option>
      <% for (const categoria of CATEGORIAS) { %>
        <option
          value="<%= categoria.valor %>"
          <%= categoriaSelecionada === categoria.valor ? 'selected' : '' %>
        >
          <%= categoria.rotulo %>
        </option>
      <% } %>
    </select>
  </div>

  <div class="form-acoes">
    <button type="submit" class="btn btn-primary">Consultar</button>
  </div>
</form>

<% if (categoriaSelecionada) { %>
  <div class="table-wrapper" style="margin-top: 1.25rem;">
    <table>
      <thead>
        <tr>
          <th>Denominação</th>
          <th>Tamanho</th>
          <th>Preço</th>
          <th>Estoque</th>
        </tr>
      </thead>
      <tbody>
        <% if (pecas.length === 0) { %>
          <tr>
            <td colspan="4">Nenhuma peça encontrada para a categoria selecionada.</td>
          </tr>
        <% } %>

        <% for (const peca of pecas) { %>
          <tr>
            <td><%= peca.denominacao %></td>
            <td><%= peca.tamanho %></td>
            <td><%= formatarMoeda(peca.preco) %></td>
            <td><%= peca.quantidadeEstoque %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>
