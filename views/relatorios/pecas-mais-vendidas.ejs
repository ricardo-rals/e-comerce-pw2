<div class="page-header">
  <h1>Relatório de Peças Mais Vendidas</h1>
</div>

<p style="margin-bottom: 1rem; color: #4A5568;">
  A receita exibida considera somente itens de vendas com status <strong>FINALIZADA</strong>.
</p>

<form method="GET" action="/relatorios/pecas-mais-vendidas" class="form-filtro">
  <div class="campo">
    <label for="dataInicio">Data inicial da venda</label>
    <input type="date" id="dataInicio" name="dataInicio" value="<%= filtro.dataInicio %>" />
  </div>
  <div class="campo">
    <label for="dataFim">Data final da venda</label>
    <input type="date" id="dataFim" name="dataFim" value="<%= filtro.dataFim %>" />
  </div>
  <div class="form-acoes">
    <button type="submit" class="btn btn-primary">Filtrar</button>
    <a href="/relatorios/pecas-mais-vendidas" class="btn btn-secundario">Limpar</a>
  </div>
</form>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Denominação</th>
        <th>Tamanho</th>
        <th>Quantidade Total Vendida</th>
        <th>Receita Obtida</th>
      </tr>
    </thead>
    <tbody>
      <% if (pecas.length === 0) { %>
        <tr>
          <td colspan="4">Nenhuma peça vendida em vendas finalizadas.</td>
        </tr>
      <% } %>

      <% for (const peca of pecas) { %>
        <tr>
          <td><%= peca.denominacao %></td>
          <td><%= peca.tamanho %></td>
          <td><%= peca.quantidadeTotalVendida %></td>
          <td><%= formatarMoeda(peca.receitaObtida) %></td>
        </tr>
      <% } %>
    </tbody>
    <% if (pecas.length > 0) {
         const totalQtd     = pecas.reduce((s, p) => s + p.quantidadeTotalVendida, 0);
         const totalReceita = pecas.reduce((s, p) => s + p.receitaObtida, 0);
         const rotuloTotal  = paginacao.totalPaginas > 1 ? 'Total da página' : 'Total';
    %>
    <tfoot>
      <tr>
        <td colspan="2"><strong><%= rotuloTotal %></strong></td>
        <td><strong><%= totalQtd %></strong></td>
        <td><strong><%= formatarMoeda(Math.round(totalReceita * 100) / 100) %></strong></td>
      </tr>
    </tfoot>
    <% } %>
  </table>
</div>

<%- include('../partials/paginacao', { paginacao, queryBase: filtro }) %>
