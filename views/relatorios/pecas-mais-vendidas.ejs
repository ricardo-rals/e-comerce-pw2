<div class="page-header">
  <h1>Relatório de Peças Mais Vendidas</h1>
</div>

<p style="margin-bottom: 1rem; color: #4A5568;">
  A receita exibida considera somente itens de vendas com status <strong>FINALIZADA</strong>.
</p>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Denominação</th>
        <th>Tamanho</th>
        <th>Quantidade Total Vendida</th>
        <th>Receita Obtida</th>
      </tr>
    </thead>
    <tbody>
      <% if (pecas.length === 0) { %>
        <tr>
          <td colspan="4">Nenhuma peça vendida em vendas finalizadas.</td>
        </tr>
      <% } %>

      <% for (const peca of pecas) { %>
        <tr>
          <td><%= peca.denominacao %></td>
          <td><%= peca.tamanho %></td>
          <td><%= peca.quantidadeTotalVendida %></td>
          <td><%= formatarMoeda(peca.receitaObtida) %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
