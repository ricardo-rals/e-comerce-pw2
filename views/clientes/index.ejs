<div class="page-header">
  <h1>Clientes</h1>
  <a href="/clientes/novo" class="btn btn-primary">+ Novo Cliente</a>
</div>

<form method="GET" action="/clientes" class="form-filtro">
  <div class="campo">
    <label for="busca">Buscar</label>
    <input type="text" id="busca" name="busca" placeholder="Nome ou CPF..."
           value="<%= filtro.busca %>" />
  </div>
  <div class="form-acoes">
    <button type="submit" class="btn btn-primary">Filtrar</button>
    <a href="/clientes" class="btn btn-secundario">Limpar</a>
  </div>
</form>

<% if (clientes.length === 0) { %>
  <p class="vazio">Nenhum cliente cadastrado.</p>
<% } else { %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>CPF</th>
          <th>Telefone</th>
          <th>E-mail</th>
          <th>Nascimento</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% for (const c of clientes) { %>
          <tr>
            <td><%= c.nome %></td>
            <td><%= c.cpf %></td>
            <td><%= c.telefone %></td>
            <td><%= c.email %></td>
            <td><%= formatarData(c.dataNascimento) %></td>
            <td class="acoes">
              <a href="/clientes/<%= c.id %>/editar" class="btn btn-secundario">Editar</a>
              <form method="POST" action="/clientes/<%= c.id %>"
                    class="form-inline"
                    data-confirm="Deseja excluir o cliente <%= c.nome %>?">
                <input type="hidden" name="_method" value="DELETE" />
                <button type="submit" class="btn btn-perigo">Excluir</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>
