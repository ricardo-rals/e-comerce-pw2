<div class="page-header">
  <h1>Clientes</h1>
  <a href="/clientes/novo" class="btn btn-primary">+ Novo Cliente</a>
</div>

<form method="GET" action="/clientes" class="form-filtro" data-live data-alvo="#lista-container">
  <div class="campo">
    <label for="busca">Buscar</label>
    <input type="text" id="busca" name="busca" placeholder="Nome ou CPF..."
           value="<%= filtro.busca %>" autocomplete="off" />
  </div>
  <div class="campo campo-check">
    <label>
      <input type="checkbox" name="inativos" value="1" <%= filtro.inativos === '1' ? 'checked' : '' %> />
      Mostrar inativos
    </label>
  </div>
  <div class="form-acoes">
    <button type="submit" class="btn btn-primary">Filtrar</button>
    <a href="/clientes" class="btn btn-secundario">Limpar</a>
  </div>
</form>

<div id="lista-container">
  <%- include('_tabela') %>
</div>
