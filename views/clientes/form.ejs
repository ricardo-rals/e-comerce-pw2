<%
  const editando = cliente && cliente.id != null;
  const action   = editando ? `/clientes/${cliente.id}` : '/clientes';
  const dataNasc = cliente
    ? (cliente.dataNascimento instanceof Date
        ? cliente.dataNascimento.toISOString().split('T')[0]
        : cliente.dataNascimento)
    : '';
  const maxDataNasc = new Date().toISOString().split('T')[0];
  const ce = typeof campoErro !== 'undefined' ? campoErro : null;
%>

<div class="page-header">
  <h1><%= title %></h1>
  <a href="/clientes" class="btn btn-secundario">← Voltar</a>
</div>

<% if (erro) { %>
  <div class="alert alert-erro"><%= erro %></div>
<% } %>

<form method="POST" action="<%= action %>" class="form-card">
  <% if (editando) { %>
    <input type="hidden" name="_method" value="PUT" />
  <% } %>

  <div class="campo<%= ce === 'nome' ? ' campo--erro' : '' %>">
    <label for="nome">Nome completo</label>
    <input type="text" id="nome" name="nome" required maxlength="120"
           value="<%= cliente ? cliente.nome : '' %>" />
  </div>

  <div class="campo<%= ce === 'cpf' ? ' campo--erro' : '' %>">
    <label for="cpf">CPF</label>
    <input type="text" id="cpf" name="cpf" required placeholder="000.000.000-00"
           maxlength="14" pattern="[0-9]{3}\.[0-9]{3}\.[0-9]{3}-[0-9]{2}"
           title="Formato: 000.000.000-00"
           value="<%= cliente ? cliente.cpf : '' %>" />
  </div>

  <div class="campo<%= ce === 'telefone' ? ' campo--erro' : '' %>">
    <label for="telefone">Telefone</label>
    <input type="text" id="telefone" name="telefone" required placeholder="(00) 00000-0000"
           maxlength="15" pattern="\([0-9]{2}\) [0-9]{5}-[0-9]{4}"
           title="Formato: (00) 00000-0000"
           value="<%= cliente ? cliente.telefone : '' %>" />
  </div>

  <div class="campo<%= ce === 'email' ? ' campo--erro' : '' %>">
    <label for="email">E-mail</label>
    <input type="email" id="email" name="email" required maxlength="120"
           value="<%= cliente ? cliente.email : '' %>" />
  </div>

  <div class="campo<%= ce === 'dataNascimento' ? ' campo--erro' : '' %>">
    <label for="dataNascimento">Data de nascimento</label>
    <input type="date" id="dataNascimento" name="dataNascimento" required
           max="<%= maxDataNasc %>"
           value="<%= dataNasc %>" />
  </div>

  <div class="form-acoes">
    <button type="submit" class="btn btn-primary">
      <%= editando ? 'Salvar alterações' : 'Cadastrar cliente' %>
    </button>
    <a href="/clientes" class="btn btn-secundario">Cancelar</a>
  </div>
</form>
