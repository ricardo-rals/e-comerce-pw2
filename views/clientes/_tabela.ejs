<% if (clientes.length === 0) { %>
  <p class="vazio">Nenhum cliente encontrado.</p>
<% } else { %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>CPF</th>
          <th>Telefone</th>
          <th>E-mail</th>
          <th>Nascimento</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% for (const c of clientes) { %>
          <tr class="<%= c.ativo ? '' : 'linha-inativa' %>">
            <td>
              <%= c.nome %>
              <% if (!c.ativo) { %><span class="tag-inativo">inativo</span><% } %>
            </td>
            <td><%= c.cpf %></td>
            <td><%= c.telefone %></td>
            <td><%= c.email %></td>
            <td><%= formatarData(c.dataNascimento) %></td>
            <td class="acoes">
              <a href="/clientes/<%= c.id %>/historico" class="btn btn-secundario">Histórico</a>
              <% if (c.ativo) { %>
                <a href="/clientes/<%= c.id %>/editar" class="btn btn-secundario">Editar</a>
                <form method="POST" action="/clientes/<%= c.id %>"
                      class="form-inline"
                      data-confirm="Inativar o cliente <%= c.nome %>? O histórico de compras será mantido.">
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit" class="btn btn-perigo">Inativar</button>
                </form>
              <% } else { %>
                <form method="POST" action="/clientes/<%= c.id %>/reativar" class="form-inline">
                  <button type="submit" class="btn btn-primary">Reativar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/paginacao', { paginacao, queryBase: filtro }) %>
<% } %>
