<div class="page-header">
  <h1>Peças de Roupa</h1>
  <a href="/pecas/novo" class="btn btn-primary">+ Nova Peça</a>
</div>

<form method="GET" action="/pecas" class="form-filtro">
  <div class="campo">
    <label for="busca">Buscar</label>
    <input type="text" id="busca" name="busca" placeholder="Denominação..."
           value="<%= filtro.busca %>" />
  </div>
  <div class="campo">
    <label for="categoria">Categoria</label>
    <select id="categoria" name="categoria">
      <option value="">Todas</option>
      <% for (const cat of CATEGORIAS) { %>
        <option value="<%= cat.valor %>" <%= filtro.categoria === cat.valor ? 'selected' : '' %>>
          <%= cat.rotulo %>
        </option>
      <% } %>
    </select>
  </div>
  <div class="form-acoes">
    <button type="submit" class="btn btn-primary">Filtrar</button>
    <a href="/pecas" class="btn btn-secundario">Limpar</a>
  </div>
</form>

<% if (pecas.length === 0) { %>
  <p class="vazio">Nenhuma peça cadastrada.</p>
<% } else { %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Denominação</th>
          <th>Categoria</th>
          <th>Tamanho</th>
          <th>Preço</th>
          <th>Estoque</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% for (const p of pecas) {
             const catRotulo = CATEGORIAS.find(c => c.valor === p.categoria)?.rotulo ?? p.categoria;
        %>
          <tr>
            <td><%= p.denominacao %></td>
            <td><%= catRotulo %></td>
            <td><%= p.tamanho %></td>
            <td><%= formatarMoeda(p.preco) %></td>
            <td class="<%= p.quantidadeEstoque === 0 ? 'estoque-zero' : '' %>">
              <%= p.quantidadeEstoque %>
            </td>
            <td class="acoes">
              <a href="/pecas/<%= p.id %>/editar" class="btn btn-secundario">Editar</a>
              <form method="POST" action="/pecas/<%= p.id %>"
                    class="form-inline"
                    data-confirm="Deseja excluir <%= p.denominacao %> (<%- p.tamanho %>)?">
                <input type="hidden" name="_method" value="DELETE" />
                <button type="submit" class="btn btn-perigo">Excluir</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/paginacao', { paginacao, queryBase: filtro }) %>
<% } %>
