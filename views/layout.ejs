<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — Venda Roupas' : 'Venda Roupas' %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <% if (typeof pageCSS !== 'undefined' && pageCSS) { %>
    <link rel="stylesheet" href="/css/<%= pageCSS %>" />
  <% } %>
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <% if (locals.flashSucesso) { %>
      <div class="flash flash-sucesso">✓ <%= locals.flashSucesso %></div>
    <% } %>

    <% if (locals.flashErro) { %>
      <div class="flash flash-erro">✕ <%= locals.flashErro %></div>
    <% } %>

    <%- body %>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
</body>
</html>
