<div class="page-header">
  <h1>Vendas</h1>
  <a href="/vendas/novo" class="btn btn-primary">+ Nova Venda</a>
</div>

<form method="GET" action="/vendas" class="form-filtro">
  <div class="campo">
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="">Todos</option>
      <% for (const s of STATUS_VENDA) { %>
        <option value="<%= s.valor %>" <%= filtro.status === s.valor ? 'selected' : '' %>>
          <%= s.rotulo %>
        </option>
      <% } %>
    </select>
  </div>
  <div class="campo">
    <label for="dataInicio">Data início</label>
    <input type="date" id="dataInicio" name="dataInicio" value="<%= filtro.dataInicio %>" />
  </div>
  <div class="campo">
    <label for="dataFim">Data fim</label>
    <input type="date" id="dataFim" name="dataFim" value="<%= filtro.dataFim %>" />
  </div>
  <div class="form-acoes">
    <button type="submit" class="btn btn-primary">Filtrar</button>
    <a href="/vendas" class="btn btn-secundario">Limpar</a>
  </div>
</form>

<% if (vendas.length === 0) { %>
  <p class="vazio">Nenhuma venda cadastrada.</p>
<% } else { %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Data</th>
          <th>Cliente</th>
          <th>Forma de Pagamento</th>
          <th>Status</th>
          <th>Valor Total</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% for (const v of vendas) {
             const formaPagamento = formaPagamentoRotulos[v.formaPagamento] ?? v.formaPagamento;
             const statusRotulo = (STATUS_VENDA.find(s => s.valor === v.status) || {}).rotulo || v.status;
        %>
          <tr>
            <td><strong>#<%= v.id %></strong></td>
            <td><%= formatarData(v.dataVenda) %></td>
            <td><%= v.cliente.nome %></td>
            <td><%= formaPagamento %></td>
            <td>
              <span class="status-badge status-<%= v.status.toLowerCase() %>">
                <%= statusRotulo %>
              </span>
            </td>
            <td><strong><%= formatarMoeda(v.valorTotal) %></strong></td>
            <td class="acoes">
              <a href="/vendas/<%= v.id %>" class="btn btn-secundario">Detalhe</a>
              <% if (v.status === 'ABERTA') { %>
                <form method="POST" action="/vendas/<%= v.id %>"
                      class="form-inline"
                      data-confirm="Cancelar a venda #<%= v.id %>? O estoque será estornado.">
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit" class="btn btn-perigo">Cancelar</button>
                </form>
              <% } else if (v.status === 'FINALIZADA') { %>
                <form method="POST" action="/vendas/<%= v.id %>/troca"
                      class="form-inline"
                      data-confirm="Registrar troca da venda #<%= v.id %>? Ela será devolvida e uma nova venda será aberta.">
                  <button type="submit" class="btn btn-secundario">Troca</button>
                </form>
                <form method="POST" action="/vendas/<%= v.id %>"
                      class="form-inline"
                      data-confirm="Devolver a venda #<%= v.id %>? O estoque será estornado.">
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit" class="btn btn-perigo">Devolver</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/paginacao', { paginacao, queryBase: filtro }) %>
<% } %>
